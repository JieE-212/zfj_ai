      "check": "output_covers_three_agenda_items"
    },
    {
      "id": "m1_budget_unconfirmed",
      "description": "标注200万预算尚未获财务批准",
      "check": "output_notes_budget_not_approved"
    },
    {
      "id": "m1_influencer_cut_compromise",
      "description": "捕获David对网红营销预算削减的异议及分阶段削减的折中方案",
      "check": "output_captures_phased_influencer_cut"
