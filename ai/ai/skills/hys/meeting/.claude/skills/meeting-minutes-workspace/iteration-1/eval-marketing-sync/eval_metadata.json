      "check": "output_covers_all_action_items"
    },
    {
      "id": "m1_bilingual",
      "description": "输出为中英双语",
      "check": "output_is_bilingual"
    },
    {
      "id": "m1_black_friday_sea",
      "description": "记录了Black Friday东南亚市场试点决策",
      "check": "output_mentions_black_friday_sea_pilot"
    },
    {
      "id": "m1_oct25_deadline",
      "description": "记录了10月25日视觉素材截止日期及初步版本的折中",
      "check": "output_captures_oct25_visual_deadline"
    }
  ]
