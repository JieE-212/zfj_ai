{
  "eval_id": 2,
  "eval_name": "eval-marketing-sync",
  "prompt": "请根据以下会议文字稿生成会议纪要（市场营销周同步会，中英混合）",
  "assertions": [
    {
      "id": "m1_has_basic_info",
      "description": "输出包含会议基本信息章节",
      "check": "output_contains_section_meeting_basic_info"
    },
    {
      "id": "m1_correct_attendees",
